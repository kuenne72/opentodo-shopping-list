# Address of your OpenTodo instance (required), as reachable from the einkauf container
OPENTODO_URL=https://opentodo.example.net

# Encrypts the API tokens stored in the database (required). Generate once and keep it:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EINKAUF_SECRET=

# Webhook secret (whsec_...) shown once when you create the webhook in OpenTodo
EINKAUF_WEBHOOK_SECRET=

# Person whose token is used for the full sync / polling (name as entered under People)
EINKAUF_SYNC_USER=

# Project is found by name; set the ID instead if you have several projects with that name
EINKAUF_PROJECT_NAME=Shopping
# EINKAUF_PROJECT_ID=

# Language of default sections and catalog: de | en
EINKAUF_LANG=en

# Fallback full sync interval in seconds
EINKAUF_POLL_SECONDS=300
